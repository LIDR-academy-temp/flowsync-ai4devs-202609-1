SESSION_DRIVER=memory

# Database (PostgreSQL de pruebas, servicio `db-test` de compose.yaml). Este
# fichero solo se carga con NODE_ENV=test (lo pone `node ace test`) y pisa a
# `.env`, así que la batería nunca toca la base de desarrollo.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
