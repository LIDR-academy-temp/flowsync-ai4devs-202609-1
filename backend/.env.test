# Solo se carga con NODE_ENV=test (lo pone `node ace test`) y sus valores
# prevalecen sobre los de .env. Apunta la suite al servicio `db-test` de
# compose.yaml, en memoria, en vez de a la base de desarrollo.
SESSION_DRIVER=memory

DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
