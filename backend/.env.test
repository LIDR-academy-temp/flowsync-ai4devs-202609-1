SESSION_DRIVER=memory

# La batería de pruebas pega contra `db-test` de compose.yaml (en memoria, sin
# volumen), nunca contra la base de desarrollo. Este fichero solo se carga con
# NODE_ENV=test y tiene prioridad sobre .env; el resto de DB_* se hereda de ahí.
DB_PORT=54411
DB_DATABASE=flowsync_test
